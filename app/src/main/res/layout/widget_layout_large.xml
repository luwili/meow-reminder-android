<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_large"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_large_cat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_cat"
            android:contentDescription="@string/widget_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_large_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_large_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_badge_ok_text"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/widget_large_btn_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_quick_button_background"
            android:src="@drawable/ic_widget_add"
            android:padding="6dp"
            android:contentDescription="@string/widget_quick_add_desc" />
    </LinearLayout>

    <!-- Hero Card when dose is due/next -->
    <LinearLayout
        android:id="@+id/widget_large_hero_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_hero_background"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_large_hero_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_overdue_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_badge_due"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_badge_overdue_text" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_large_hero_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_large_hero_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_large_hero_dosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/widget_large_hero_action_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_button_background"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_check"
                android:contentDescription="@string/widget_btn_take" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Отметить приём"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/widget_button_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty / All Done Card for Large Widget -->
    <LinearLayout
        android:id="@+id/widget_large_all_taken_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_card_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_all_done_title"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/widget_text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_all_taken"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:gravity="center" />
    </LinearLayout>

    <!-- Upcoming List Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_large_upcoming_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запланировано на сегодня:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/widget_large_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_pill"
                android:contentDescription="Таблетка" />

            <TextView
                android:id="@+id/widget_large_item_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_large_item_1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_large_item_1_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_pill"
                android:contentDescription="Таблетка" />

            <TextView
                android:id="@+id/widget_large_item_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_large_item_2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_large_item_2_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_large_upcoming_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Больше приёмов не запланировано ✨"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Mascot Phrase Footer -->
    <TextView
        android:id="@+id/widget_large_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
