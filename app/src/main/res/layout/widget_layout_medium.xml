<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_medium"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_medium_cat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_cat"
            android:contentDescription="@string/widget_name" />

        <TextView
            android:id="@+id/widget_medium_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_medium_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_badge_ok_text"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/widget_medium_btn_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_quick_button_background"
            android:src="@drawable/ic_widget_add"
            android:padding="5dp"
            android:contentDescription="@string/widget_quick_add_desc" />
    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- Active Due / Next Dose Container -->
        <LinearLayout
            android:id="@+id/widget_medium_hero_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_hero_background"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widget_medium_hero_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/widget_text_primary" />

                <TextView
                    android:id="@+id/widget_medium_hero_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_medium_hero_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_secondary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_medium_hero_action_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/widget_button_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_check"
                    android:contentDescription="@string/widget_btn_take" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Принял"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/widget_button_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty / All Taken State -->
        <LinearLayout
            android:id="@+id/widget_medium_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_card_background"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_medium_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_all_done_title"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/widget_text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/widget_medium_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_all_taken"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
